# Claude
ANTHROPIC_API_KEY=sk-ant-...

# Supabase (service-role key — server-side only, NEVER ship to the web app)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Trigger server (the web app's "Generate" buttons call this)
PORT=8787
# Production only: lock CORS to your deployed web origin, e.g. https://founderos.vercel.app
# Leave unset for local dev (defaults to *).
ALLOWED_ORIGIN=

# Google OAuth — optional until Week 4 (Inbox / Sales / Legal stay dormant without these)
# One-time refresh token with scopes: gmail.modify, calendar.readonly, drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# beehiiv newsletter publishing — optional. When set, approving a `newsletter`
# draft creates a beehiiv DRAFT post (you still hit send in beehiiv).
# Create-post is an Enterprise-tier endpoint. Publication: "The Sunday Read".
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=pub_4a80dba6-f8f8-4115-bba5-d7f4a9a64d3c

# Resend Broadcasts — newsletter publishing (preferred over beehiiv when set).
# Approving a `newsletter` draft creates a Resend broadcast DRAFT (you send it from the
# Resend dashboard) unless RESEND_AUTOSEND=true. Needs a verified sending domain for RESEND_FROM.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
RESEND_FROM=Sunday <hello@yourdomain.com>
RESEND_AUTOSEND=false

# Optional per-agent model / effort overrides (cost control).
#   MODEL_<AGENT>=opus|sonnet|haiku   EFFORT_<AGENT>=low|medium|high
# The dominant Opus cost is the daily inbox brief. To cut it sharply:
# MODEL_INBOX=sonnet
# EFFORT_INBOX=medium
# MODEL_CEO=sonnet
